# Headroom local configuration. Copy to `.env` (gitignored) and edit as needed:
#
#     cp .env.example .env
#
# Everything here has a working default in docker-compose.yml, so a bare
# `docker compose up` needs no `.env` at all. This file exists to document the knobs
# and to be the ONLY place a real credential ever lives locally — never compose,
# never a task definition's plain environment, never git (BUILD_PLAN §0.2
# invariant 3). Set real keys with a leading space so they stay out of shell history.

# Host ports sidestep 5432/8000 on purpose so this stack coexists with anything
# already running on a developer's machine (docs/DECISIONS.md H-006).

# ── Postgres (config, keys, ledger, semantic cache) ─────────────────────────────
POSTGRES_USER=headroom
POSTGRES_PASSWORD=headroom
POSTGRES_DB=headroom
DB_PORT=5433

# ── DynamoDB Local (budget reservations and token buckets) ──────────────────────
# Host port 8001 — the container listens on 8000, same as the gateway.
DYNAMODB_PORT=8001
AWS_REGION=us-east-1
# DynamoDB Local never validates a signature; boto3 just needs something to sign
# with. If you leave these unset entirely, the gateway supplies its own dummy — but
# only when DYNAMODB_ENDPOINT_URL says an emulator is being addressed. Against real
# DynamoDB nothing is invented and a missing credential fails loudly.
#
# NOTE the absence of a hyphen. DynamoDB Local *does* parse the access key id out of
# the SigV4 credential scope and rejects one containing `-` with
# `UnrecognizedClientException: The Access Key ID or security token is invalid` —
# which reads exactly like a real AWS auth failure (docs/DECISIONS.md H-030).
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# ── Budgets (Phase 4) ───────────────────────────────────────────────────────────
# The DynamoDB table holding per-tenant caps, counters, and live reservations. One
# item per budgeted tenant; created on first use locally and in CI, created by
# Terraform in Phase 9 — the same code path finds it either way.
#
# Budgets are OFF until you set one. An uncapped tenant is admitted and nothing is
# held; a capped one is gated by an atomic conditional write before the request ever
# reaches a provider:
#
#     curl -sS -X PUT localhost:8080/admin/budgets/<tenant-id> \
#          -H "Authorization: Bearer $HEADROOM_ADMIN_TOKEN" \
#          -H 'content-type: application/json' \
#          -d '{"usd": "25.00", "window": "monthly"}'
#
# `usd` is a QUOTED string — a JSON number is a double, and the API refuses one by
# name, the same rule config/models.yaml enforces on rates (H-023).
# HEADROOM_BUDGETS_TABLE=headroom_budgets

# ── Rate limits (Phase 4b) ──────────────────────────────────────────────────────
# The DynamoDB table holding token buckets. One item per (scope, dimension), each
# holding a single number — the time the bucket will next be full — so that refill
# and consumption are one atomic conditional write. A *second* table rather than more
# rows in the budget one: budget items must never be reaped and bucket items are safe
# to reap, since an absent bucket and a full bucket are the same state (H-035).
#
# Rate limits are OFF until you set one, per tenant and per key. The limits themselves
# live in Postgres (BUILD_PLAN L2: config there, buckets here), so they arrive on the
# request path for free — and a change takes effect on the next request in the process
# that made it, and within 5s everywhere else, exactly like a scope change (H-037).
#
#     curl -sS -X PUT localhost:8080/admin/limits/tenant/<tenant-id> \
#          -H "Authorization: Bearer $HEADROOM_ADMIN_TOKEN" \
#          -H 'content-type: application/json' \
#          -d '{"requests_per_min": 60, "tokens_per_min": 100000}'
#
# PUT *replaces*: an omitted dimension is unlimited, not unchanged. A refusal is a 429
# with `retry-after` and `x-headroom-ratelimit-*` headers — and it is distinguishable
# from a provider's own 429 by `x-headroom-error-source: gateway`, which no upstream
# response can forge because the whole `x-headroom-*` namespace is stripped from every
# upstream response (H-038). `DELETE` clears the limits *and* empties the buckets.
# HEADROOM_BUCKETS_TABLE=headroom_buckets

# ── Gateway ─────────────────────────────────────────────────────────────────────
GATEWAY_PORT=8080

# ── The operator console (Phase 7) ──────────────────────────────────────────────
# 3001, not 3000: Backline's UI holds 3000 on this machine, and §P8.H2 needs both
# stacks up at once — H-006's argument, one service along.
UI_PORT=3001

# Where the console looks for the gateway. The compose default is the service name and
# needs no setting. **Set it when the gateway runs on the host instead of in compose**,
# which is what the two-GPU kill demo does so that localhost:8010 and :8011 mean the
# vLLM instances:
#
#      HEADROOM_GATEWAY_URL=http://host.docker.internal:8090
#
# There is deliberately **no admin token variable for the console**. It is handed no
# secret at all, not even by reference: the operator types the root token into the
# sign-in screen and the console's own server exchanges it for an httpOnly session
# cookie (docs/DECISIONS.md H-055). One fewer place invariant 3 can be violated, and
# nothing to scrub out of a browser bundle.
# HEADROOM_GATEWAY_URL=http://gateway:8000

# ── The root admin token (Phase 2) ──────────────────────────────────────────────
# Guards /admin/tenants and /admin/keys. NEVER commit a value here — this file is in
# git and the variable belongs in the gitignored `.env`, set with a LEADING SPACE so
# it stays out of shell history (BUILD_PLAN §0.2 invariant 3).
#
# Unset means the admin API is **OFF**, not open: every /admin route answers 503
# naming this variable (docs/DECISIONS.md H-019). Generate one with:
#
#      python -c 'import secrets; print(secrets.token_urlsafe(32))'
#
# HEADROOM_ADMIN_TOKEN=
#
# Virtual keys (`hk_…`) are a different credential entirely: they are minted through
# the admin API, hashed at rest, and never appear in any file. The plaintext is
# returned by `POST /admin/keys` exactly once and is unrecoverable afterwards.

# ── Running the service-container tests from the host (`make test`) ─────────────
# Since Phase 1 these find the compose stack on their own: after `make up`, a bare
# `make test` runs them against the ports above with nothing exported, and skips with
# a message if nothing is listening (docs/DECISIONS.md H-012). Set these to point the
# tests somewhere else — and note that an explicit value that is unreachable becomes a
# failure rather than a skip, which is what keeps CI honest about its containers.
#
#     DATABASE_URL=postgresql://headroom:headroom@localhost:5433/headroom
#     DYNAMODB_ENDPOINT_URL=http://localhost:8001

# ── Routing (Phase 1) ───────────────────────────────────────────────────────────
# Which providers exist and who serves which model: `config/routing.yaml`, committed
# and secret-free. Point this at another file to run with a different table.
# HEADROOM_ROUTING_CONFIG=config/routing.yaml

# ── Prices (Phase 3) ────────────────────────────────────────────────────────────
# Model ids, dialects, context windows, and DATED price schedules:
# `config/models.yaml`, committed and secret-free. A model has a *history* of prices
# and a request is billed at the row in effect on the day it arrived, so a rate
# change can never reprice a request that already happened (Backline's D-017 scar,
# made structural). Rates are quoted strings; an unquoted number is a YAML float and
# the loader refuses it, because money in binary floating point is wrong before
# anything multiplies it.
#
# A model with no row for that date is recorded as `unpriced_model` with a NULL cost
# — never as free. Point this at another file to run with different rates.
# HEADROOM_MODELS_CONFIG=config/models.yaml

# ── The semantic cache's embedder (Phase 5) ─────────────────────────────────────
# Which model turns a question into a vector. BUILD_PLAN L6 fixes the production
# answer — BAAI/bge-small-en-v1.5, on CPU — and that is the default, so this variable
# normally stays unset.
#
# Phase 9 settled how the deploy image gets those weights, and it is not this variable:
# `docker build --build-arg WITH_EMBED=1` installs the extra and bakes the model into a
# layer under HF_HOME=/opt/hf, and the task definition sets HF_HUB_OFFLINE=1 so a cache
# miss is an error rather than a 130 MB fetch from HuggingFace mid-request. The model id
# stays the code's default in both places (H-076). Neither variable belongs in a local
# `.env` — HF_HOME is baked and HF_HUB_OFFLINE would break `uv sync --extra embed`'s first
# run on this machine.
#
# Two things worth knowing before changing it.
#
#   1. It needs the extra: `uv sync --extra embed`. There is deliberately NO fallback —
#      a gateway that silently degraded to a bag-of-words embedder would keep answering,
#      keep hitting, and quietly stop being the system anybody measured. Enabling
#      semantic caching for a tenant (`PUT /admin/cache/{id}`) loads the model there and
#      then, so a missing one is a 503 on the request that asked for it rather than a
#      surprise on somebody's traffic an hour later.
#   2. The model id is part of the semantic cache's namespace. Changing this does not
#      corrupt anything — entries written under the old id simply stop matching — but it
#      does make every existing entry unreachable by similarity, which is the correct
#      behaviour for a different vector space and a surprising one if unexpected.
#
# `hashing` selects the dependency-free deterministic embedder: real lexical similarity,
# no torch, and no ability to tell a paraphrase from a near-miss. It exists for keyless
# environments, not as a smaller version of the real thing.
# HEADROOM_EMBEDDER=BAAI/bge-small-en-v1.5

# ── Provider credentials and endpoints (Phase 1 onward) ─────────────────────────
# Never commit a real value; set them with a LEADING SPACE so they stay out of shell
# history. The gateway boots fine without any of them — a deployment routing only
# mock and vLLM traffic needs none — and a route that needs a missing key fails on
# that request, naming the variable to set.
#
# Live provider tests are opt-in and cost money: `uv run pytest -m live`.
# ANTHROPIC_API_KEY=
#
# The operator's TWO vLLM instances (BUILD_PLAN L5) — one per 4090, and the pair
# `config/routing.yaml` chains together for Phase 6's kill demo. Either spelling
# works, with or without a trailing /v1 (docs/DECISIONS.md H-011).
#
# The verified topology is in docs/vllm.md: instance A on host port 8010, instance B
# on 8011, same launch flags, pinned to a card each with `--gpus all` plus
# `CUDA_VISIBLE_DEVICES=<UUID>`. The defaults baked into routing.yaml already match,
# so on this machine neither variable needs setting at all.
#
# One address, two meanings: `localhost` is right when you run the gateway on the
# host (`uv run pytest -m live`, `uvicorn`), and wrong inside the compose container,
# where it points at the container itself. For a vLLM on this machine reached from
# the container, use host.docker.internal; for one on another box, its LAN address.
# VLLM_BASE_URL=http://localhost:8010     # instance A — the chain's primary
# VLLM_B_BASE_URL=http://localhost:8011   # instance B — the fallback
# VLLM_MODEL=            # optional; the live smoke discovers it from /v1/models
# VLLM_API_KEY=          # usually unset: a local vLLM serves without auth
