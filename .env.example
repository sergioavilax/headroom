# Headroom local configuration. Copy to `.env` (gitignored) and edit as needed:
#
#     cp .env.example .env
#
# Everything here has a working default in docker-compose.yml, so a bare
# `docker compose up` needs no `.env` at all. This file exists to document the knobs
# and to be the ONLY place a real credential ever lives locally — never compose,
# never a task definition's plain environment, never git (BUILD_PLAN §0.2
# invariant 3). Set real keys with a leading space so they stay out of shell history.

# Host ports sidestep 5432/8000 on purpose so this stack coexists with anything
# already running on a developer's machine (docs/DECISIONS.md H-006).

# ── Postgres (config, keys, ledger, semantic cache) ─────────────────────────────
POSTGRES_USER=headroom
POSTGRES_PASSWORD=headroom
POSTGRES_DB=headroom
DB_PORT=5433

# ── DynamoDB Local (token buckets, budget reservations) ─────────────────────────
# Host port 8001 — the container listens on 8000, same as the gateway.
DYNAMODB_PORT=8001
AWS_REGION=us-east-1
# DynamoDB Local ignores these; boto3 just needs something to sign with.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# ── Gateway ─────────────────────────────────────────────────────────────────────
GATEWAY_PORT=8080

# ── Running the service-container tests from the host (`make test`) ─────────────
# Both are unset by default, and those tests skip when they are. Export them to run
# the checks against a stack you brought up with `make up`:
#
#     DATABASE_URL=postgresql://headroom:headroom@localhost:5433/headroom \
#     DYNAMODB_ENDPOINT_URL=http://localhost:8001 \
#     make test

# ── Provider keys (Phase 1 onward) ──────────────────────────────────────────────
# Never commit a real value. Live tests are opt-in: `uv run pytest -m live`.
# ANTHROPIC_API_KEY=
