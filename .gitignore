# env / secrets — no key ever reaches git (BUILD_PLAN §0.2 invariant 3)
.env
*.env.local

# python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
*.egg-info/

# node / next (the dashboard arrives in Phase 7)
node_modules/
ui/.next/
ui/out/
ui/next-env.d.ts
*.tsbuildinfo

# terraform / deploy state (Phase 9–10) — state can carry secrets, lockfiles cannot
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform/
.terraform.tfstate.lock.info

# the rollup Lambda's artifact (Phase 9), assembled by `make lambda-build` from the
# working tree plus a locked asyncpg wheel. Rebuilt in one command and platform-specific,
# so it is a build output rather than a source file — and the zip's hash is what tells
# Terraform to redeploy, which a committed copy would make a merge conflict.
deploy/aws/lambda/build/
deploy/aws/lambda/*.zip
crash.log
crash.*.log
kubeconfig
*.kubeconfig

# Phase 10's Helm values (`make k8s-config`). `deploy/k8s/values.aws.yaml` carries the
# operator's home CIDR and a tailnet address — machine-specific facts, exactly like the
# tfvars above, and out of git for the same reason. The `.example` beside it is what a
# reader sees, and `deploy/k8s/eksctl/cluster.yaml` IS committed: it holds VPC, subnet and
# security-group ids and two table ARNs, which are identifiers rather than credentials and
# are already published in `docs/evidence/p9-aws/01-data-outputs.txt`.
deploy/k8s/values.*.yaml
!deploy/k8s/values.*.yaml.example

# agent / editor / os
.claude/
.idea/
.vscode/
.DS_Store
*.plan
*.tfplan

# Launch copy is backstage material (H-100). Shipped in P11, withdrawn the same day by
# operator decision: the recruiter template in particular undermines its own purpose by
# being public, and the rest is drafting rather than engineering. Drafts still get written
# here — they just do not get committed here.
docs/launch/
