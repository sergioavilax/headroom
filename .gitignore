# env / secrets — no key ever reaches git (BUILD_PLAN §0.2 invariant 3)
.env
*.env.local

# python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
*.egg-info/

# node / next (the dashboard arrives in Phase 7)
node_modules/
ui/.next/
ui/out/
ui/next-env.d.ts
*.tsbuildinfo

# terraform / deploy state (Phase 9–10) — state can carry secrets, lockfiles cannot
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform/
.terraform.tfstate.lock.info

# the rollup Lambda's artifact (Phase 9), assembled by `make lambda-build` from the
# working tree plus a locked asyncpg wheel. Rebuilt in one command and platform-specific,
# so it is a build output rather than a source file — and the zip's hash is what tells
# Terraform to redeploy, which a committed copy would make a merge conflict.
deploy/aws/lambda/build/
deploy/aws/lambda/*.zip
crash.log
crash.*.log
kubeconfig
*.kubeconfig

# agent / editor / os
.claude/
.idea/
.vscode/
.DS_Store
*.plan
*.tfplan
